# Copy to .env and fill in. Run with: uvicorn minisakias.server:app --env-file .env

# --- the model provider ------------------------------------------------------------------------------------------
# TensorX (Ireland; EU-hosted open-weight models, OpenAI-compatible API) — the one key the service needs.
TENSORX_API_KEY=
# tensorx (default) | custom — any other OpenAI-compatible server (vLLM, llama.cpp, another host) through the two
# variables below. `custom` is refused while MINISAKIAS_REQUIRE_EU is on.
MINISAKIAS_PROVIDER=tensorx
# MINISAKIAS_LLM_BASE_URL=https://…/v1
# MINISAKIAS_LLM_API_KEY=
# Refuse a provider that is not known to run inside the EU (default 1). A citizen's legal problem is personal data.
MINISAKIAS_REQUIRE_EU=1
# Try the site without any key: the search is real, the answer is a canned notice. Never for the public.
# MINISAKIAS_DEMO=1

# --- which model answers -----------------------------------------------------------------------------------------
# The writer's model, as the provider names it — the step that decides what the citizen is told. Others on TensorX:
# z-ai/glm-5.3-flash (about a fifth of the cost, more slips) · deepseek/deepseek-v4-pro-0813 · moonshotai/kimi-k3
MINISAKIAS_MODEL=z-ai/glm-5.3
# The small model for the steps around it: router, selector, proofreader
MINISAKIAS_ROUTER_MODEL=z-ai/glm-5.3-flash
# Correct garbled words in the finished answer with one small call (default 1)
MINISAKIAS_PROOFREAD=1
# `reasoning_effort` as the model understands it — GLM: none | low | high | max · DeepSeek: low | high | max.
# Empty = not sent. The small steps only pick articles and fix spelling, so they run lighter than the writer.
MINISAKIAS_EFFORT=high
MINISAKIAS_ROUTER_EFFORT=low
# Sampling (a negative value = not sent, the provider's default applies)
MINISAKIAS_TEMPERATURE=0.3
MINISAKIAS_TOP_P=0.95
# The answer's token cap (the model's thinking counts in it) and the seconds to wait for the provider
MINISAKIAS_MAX_OUTPUT=16000
MINISAKIAS_TIMEOUT_S=120

# --- how much law the writer reads ---------------------------------------------------------------------------------
# hits kept per search, candidates offered to the selector, articles the writer reads at most
MINISAKIAS_SEARCH_LIMIT=15
MINISAKIAS_MAX_CANDIDATES=80
MINISAKIAS_MAX_ARTICLES=18
MINISAKIAS_MAX_ARTICLE_CHARS=6000
MINISAKIAS_MAX_CONTEXT_CHARS=80000

# --- limits against abuse and cost -----------------------------------------------------------------------------------
MINISAKIAS_MAX_MESSAGE_CHARS=4000
# messages of a conversation sent to the models (older ones are dropped)
MINISAKIAS_MAX_HISTORY=12
# questions per address: 6 in 300 seconds, 40 a day
MINISAKIAS_RATE_PER_WINDOW=6
MINISAKIAS_RATE_WINDOW_S=300
MINISAKIAS_RATE_PER_DAY=40
